# All values are optional. Without them TerraVision runs fully in the browser:
# maps, search and analysis call NASA GIBS, NASA POWER and OpenStreetMap
# (Photon / Nominatim) directly — none of them needs a key.

# Backend for accounts (POST /auth/login, /auth/register, /auth/logout; GET /auth/me).
# Leave empty to run in demo mode with a local "Explorer" profile.
VITE_API_BASE_URL=

# Optional AI briefing on the Analysis page. TerraVision POSTs the measured
# findings as JSON ({ systemPrompt, area, period, concern, findings,
# indicators, caveats }) and expects { "summary": string, "bullets": string[] }.
# Keep any model API key on that backend — never put secrets in VITE_ variables.
VITE_AI_ANALYSIS_ENDPOINT=
